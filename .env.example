# Local Google Drive reader. Keep these server-only; never use a VITE_ prefix.
# Leave disabled until institutional privacy/security approval is verified.
TERIIP_DRIVE_READS_ENABLED=
TERIIP_GOOGLE_SERVICE_ACCOUNT_EMAIL=
TERIIP_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Keep false until institutional privacy and security approval is verified.
TERIIP_PARTICIPANT_WORKFLOW_APPROVED=

# Browser-visible extraction service address. Use HTTPS for the Cloudflare tunnel.
VITE_TERIIP_EXTRACTION_SERVICE_URL=
# Shared HMAC signing secret; server-side only, never add a VITE_ prefix.
TERIIP_EXTRACTION_TOKEN_SECRET=
# Comma-separated browser origins allowed by the local extraction service.
TERIIP_EXTRACTION_ALLOWED_ORIGINS=

# Master tracker Google Sheet. Use the spreadsheet ID from its URL and the exact tab name.
MASTER_TRACKER_SHEET_ID=
MASTER_TRACKER_TAB=

# Supabase admin account provisioning. Keep real values in .env.local only.
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TERIIP_APP_URL=
TERIIP_AUTH_REDIRECT_ORIGINS=
TERIIP_SUPER_ADMIN_EMAIL=
